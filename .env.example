# ============================================================================
#  Simulacra — Variáveis de Ambiente (copie para `.env` e preencha)
# ============================================================================

# Chave da API da Anthropic (obrigatória para a cognição dos agentes).
# Obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelos usados em cada camada cognitiva.
#  - REASONING: reflexão e planejamento (caro, mas profundo)
#  - FAST:      ações por tick e diálogos curtos (rápido e barato)
MODEL_REASONING=claude-opus-4-8
MODEL_FAST=claude-haiku-4-5

# Porta do servidor backend
PORT=3001

# Origem permitida para o frontend (CORS / Socket.IO)
CLIENT_ORIGIN=http://localhost:5173

# Caminho do banco SQLite (o Memory Stream vive aqui)
DATABASE_PATH=./data/simulacra.sqlite

# Intervalo (ms) entre ticks da simulação
TICK_INTERVAL_MS=8000
